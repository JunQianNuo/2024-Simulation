    M2["Q2-M2<br/>状态增强的吸收Markov奖励模型<br/>4位固定策略<br/>最大化期望利润"]
    M3["Q3-M3<br/>装配树—吸收Markov闭环模型<br/>16位固定策略 · 物料守恒<br/>最大化期望利润"]
    M4B["Q4-M2<br/>Bayesian后验期望利润模型<br/>复用Q2/Q3利润函数 Π(d;p)<br/>max E[Π(d;p) | 抽样证据]"]
    M4R["Q4-M3<br/>矩形不确定集max–min模型<br/>复用Q2/Q3利润函数 Π(d;p)<br/>max_d min_p Π(d;p)"]
  end

  subgraph ALGO["③ 条件化求解算法层：不与优化模型混称"]
    direction LR
    A1["Q1-A1<br/>双单侧Bernoulli CS首次越界<br/>ConfSeq + 独立反演<br/>路径DP + 34组候选Pareto搜索"]
    A2["Q2-A1<br/>16策略完整枚举<br/>可达状态图 · SCC/吸收裕度<br/>稀疏LU多右端求解"]
    A3["Q3-A1<br/>后序局部状态核缓存<br/>65536策略分布式完整搜索<br/>确定性归并与残差复核"]
    A4B["Q4-A1<br/>Uniform/Jeffreys双先验<br/>全策略共同后验样本<br/>误差停止 + 独立确认批次"]
    A4R["Q4-A2<br/>Q1同族simultaneous CS构集<br/>单调性认证优先<br/>角点 + SHGO + DE + 区间定界"]
  end

  subgraph OUTPUT["④ 决策输出与结论称谓层"]
    direction LR
    O1["Q1输出<br/>省样本型 · 均衡型 · 低未决型<br/>候选网格内Pareto方案"]
    O2["Q2输出<br/>16策略利润表、分账与残差<br/>固定策略域精确最优集合"]
    O3["Q3输出<br/>65536策略排名、分账与残差<br/>固定策略域精确最优集合"]
    O4B["Q4 Bayesian输出<br/>后验期望利润 · 可信区间<br/>最优概率 · 遗憾 · MC误差"]
    O4R["Q4稳健输出<br/>最坏利润 · 最坏参数点<br/>certified / numerical / uncertified"]
  end

  GATE["结论门禁<br/>全策略覆盖 → 才称固定策略域精确最优<br/>独立确认批次通过 → 才确认Bayesian排序<br/>区间gap达标 → 才称ROBUST_CERTIFIED"]

  FINAL(["综合决策<br/>点估计最优 + Bayesian排序 + 稳健门禁<br/>形成可解释、可复核的抽检与生产方案"])

